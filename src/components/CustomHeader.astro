---
import DefaultHeader from '@astrojs/starlight/Header.astro';
import { getCollection } from 'astro:content';

const categories = [
  { label: 'AI 前沿', href: '/ai/', emoji: '🔬' },
  { label: '科普教程', href: '/tutorials/', emoji: '📚' },
  { label: '研究笔记', href: '/notes/', emoji: '📝' },
  { label: '研究周报', href: '/research/', emoji: '📰' },
  { label: '关于', href: '/about/', emoji: '🐱' },
];

const currentPath = Astro.url.pathname;
---

<div class="top-nav-wrapper">
  <nav class="top-nav">
    <div class="top-nav-inner">
      <a href="/" class="top-nav-logo">
        <span class="logo-icon">🐱</span>
        <span class="logo-text">金豆的 AI 笔记</span>
      </a>
      <div class="top-nav-links">
        {categories.map((cat) => (
          <a
            href={cat.href}
            class:list={['top-nav-link', { active: currentPath.startsWith(cat.href) }]}
          >
            {cat.label}
          </a>
        ))}
      </div>
    </div>
  </nav>
</div>

<style>
  .top-nav-wrapper {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--sl-color-gray-6, #e8ddd0);
    background: var(--sl-color-bg, #fefcf8);
  }

  .top-nav {
    width: 100%;
  }

  .top-nav-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }

  .top-nav-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--sl-color-heading, #3d3229);
    font-weight: 700;
    font-size: 1.1rem;
    font-family: 'Noto Serif SC', Georgia, serif;
    white-space: nowrap;
  }

  .logo-icon {
    font-size: 1.4rem;
  }

  .top-nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .top-nav-link {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.85rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--sl-color-gray-2, #5a4d3f);
    text-decoration: none;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .top-nav-link:hover {
    color: var(--sl-color-accent, #c67b3c);
    background: var(--sl-color-gray-7, #f5e6c8);
  }

  .top-nav-link.active {
    color: var(--sl-color-accent, #c67b3c);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .top-nav-inner {
      padding: 0 1rem;
      height: 48px;
    }
    .top-nav-links {
      gap: 0.1rem;
    }
    .top-nav-link {
      padding: 0.3rem 0.5rem;
      font-size: 0.8rem;
    }
    .logo-text {
      display: none;
    }
  }
</style>
