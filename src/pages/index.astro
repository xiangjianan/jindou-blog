---
import { getCollection } from 'astro:content';
import StandaloneLayout from '../components/StandaloneLayout.astro';

const allDocs = await getCollection('docs');
const posts = allDocs
  .filter((doc) => doc.id !== 'index' && doc.id !== 'about')
  .sort((a, b) => {
    const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
    const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
    return dateB - dateA;
  });

const categoryDefs = [
  {
    key: 'ai',
    label: 'AI 前沿',
    href: '/ai/',
    desc: '论文精读、模型架构和技术突破。',
  },
  {
    key: 'tutorials',
    label: '科普教程',
    href: '/tutorials/',
    desc: '从概念到机制的系统化解释。',
  },
  {
    key: 'notes',
    label: '研究笔记',
    href: '/notes/',
    desc: '研究扫描、备忘和阶段性想法。',
  },
  {
    key: 'research',
    label: '研究周报',
    href: '/research/',
    desc: 'arXiv 论文速览和趋势跟踪。',
  },
];

const categoryCounts = Object.fromEntries(
  categoryDefs.map((category) => [
    category.key,
    posts.filter((post) => post.id.startsWith(`${category.key}/`)).length,
  ])
);

const latestPosts = posts.slice(0, 8);

function formatDate(date: Date | string | undefined) {
  if (!date) return '';
  return new Date(date).toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });
}

function getCategoryLabel(id: string) {
  const key = id.split('/')[0];
  return categoryDefs.find((category) => category.key === key)?.label ?? '文章';
}
---

<StandaloneLayout title="金豆的 AI 笔记" description="金豆的 AI 研究、科普教程、论文精读和研究周报。">
  <section class="docs-hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <span class="eyebrow">AI Research Wiki</span>
      <h1 id="home-title">金豆的 AI 笔记</h1>
      <p class="hero-description">
        用 docs 的方式整理 AI 研究：论文精读、机制解释、研究备忘和周报索引放在同一个可搜索的知识库里。
      </p>
      <div class="hero-actions">
        <a class="primary-link" href="/tutorials/">开始阅读</a>
        <button class="secondary-link" type="button" data-search-open>搜索文章 <span class="shortcut">⌘K</span></button>
      </div>
    </div>

    <aside class="hero-panel" aria-label="站点概览">
      <div class="hero-panel-header">
        <span>站点索引</span>
        <span>{posts.length} 篇文章</span>
      </div>
      <div class="signal-grid">
        <div class="signal-item">
          <strong>{categoryDefs.length}</strong>
          <span>个主要栏目</span>
        </div>
        <div class="signal-item">
          <strong>{latestPosts.length}</strong>
          <span>条最新更新</span>
        </div>
        <div class="signal-item">
          <strong>⌘K</strong>
          <span>快速检索标题、描述与标签</span>
        </div>
      </div>
    </aside>
  </section>

  <section aria-labelledby="category-title">
    <div class="section-heading">
      <div>
        <h2 id="category-title">文档分类</h2>
        <p>按阅读场景组织内容，适合从概念入门，也适合快速查找研究线索。</p>
      </div>
    </div>
    <div class="category-strip">
      {categoryDefs.map((category) => (
        <a class="category-card" href={category.href}>
          <strong>{category.label}</strong>
          <span>{category.desc}</span>
          <small>{categoryCounts[category.key]} 篇文章</small>
        </a>
      ))}
    </div>
  </section>

  <section aria-labelledby="latest-title">
    <div class="section-heading">
      <div>
        <h2 id="latest-title">最新文章</h2>
        <p>按发布日期排序的最近更新。</p>
      </div>
      <button class="secondary-link" type="button" data-search-open>打开搜索</button>
    </div>
    <div class="latest-grid">
      {latestPosts.map((post) => (
        <a class="post-row" href={`/${post.id}/`}>
          <div class="post-meta">
            <span>{getCategoryLabel(post.id)}</span>
            {post.data.date && <time>{formatDate(post.data.date)}</time>}
          </div>
          <h3>{post.data.title}</h3>
          {post.data.description && <p class="post-desc">{post.data.description}</p>}
        </a>
      ))}
    </div>
  </section>
</StandaloneLayout>
